# Authentik (external server)
AUTHENTIK_ISSUER=https://auth.example.com/application/o/sweepy/
AUTHENTIK_JWKS_URI=https://auth.example.com/application/o/sweepy/jwks/

# Server
CORS_ORIGIN=http://localhost:3000

# Flutter App (set in app/.env or as build args)
API_BASE_URL=http://localhost:8080
OIDC_ISSUER=https://auth.example.com/application/o/sweepy/
OIDC_CLIENT_ID=sweepy-app
OIDC_REDIRECT_URI=com.sweepy.app://callback
OIDC_WEB_REDIRECT_URI=http://localhost:3000/callback
